# PostHog analytics
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Email — production (DigitalOcean) blocks Gmail SMTP ports.
# Use SendGrid over HTTPS instead:
# 1. Create a free account at https://sendgrid.com
# 2. Settings → API Keys → Create API Key (Mail Send permission)
# 3. Settings → Sender Authentication → verify scifables2026@gmail.com as a Single Sender
MAIL_API_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Optional Gmail SMTP (works on local Mac, usually NOT on production servers)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=scifables2026@gmail.com
MAIL_SMTP_PASSWORD=
MAIL_FROM=scifables2026@gmail.com
MAIL_FROM_NAME=SciFables
MAIL_NOTIFY_TO=scifables2026@gmail.com
